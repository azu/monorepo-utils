{
  "name": "@monorepo-utils/collect-changelog",
  "version": "3.0.1",
  "description": "Collect CHANGELOG from tags.",
  "keywords": [
    "changelog",
    "lerna",
    "monorepo"
  ],
  "homepage": "https://github.com/azu/monorepo-utils",
  "bugs": {
    "url": "https://github.com/azu/monorepo-utils/issues"
  },
  "license": "MIT",
  "author": "azu",
  "files": [
    "bin/",
    "lib/",
    "src/",
    "template/"
  ],
  "main": "lib/collect-changelog-from-tag.js",
  "types": "lib/collect-changelog-from-tag.d.ts",
  "bin": {
    "monorepo-utils-collect-changelog": "./bin/cmd.js"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azu/monorepo-utils.git"
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['lib']) require('node:fs').rmSync(d, { recursive: true, force: true })\" && tsc -b --clean",
    "build": "tsc -b .",
    "postcommit": "git reset",
    "prepublish": "npm run --if-present build",
    "test": "jest --no-cache",
    "test:updateSnapshot": "jest -u",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,css}'",
    "watch": "tsc -b . --watch"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 4
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testRegex": "./test/.*.ts$",
    "rootDir": ".",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "dependencies": {
    "@monorepo-utils/package-utils": "^3.0.1",
    "cclog-parser": "^1.1.1",
    "handlebars": "^4.7.10"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
